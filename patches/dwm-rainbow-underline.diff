+/* 全局窗口内部右上角的图钉徽章: 透明背景上一个白色图钉 (字号为状态栏字体高度的 4 倍),
+ * 徽章大小即图钉字形外框, 紧贴边框内侧右上角; 鼠标可穿透
+ * 窗口不是全局时销毁; 隐藏或全屏时取消映射; 其余情况跟随窗口位置并叠在窗口之上 */
+void
+updatebadge(Client *c)
+{
+    static Pixmap pm = None;
+    static int badgew, badgeh; /* 徽章宽高 = 图钉字形外框 */
+    XSetWindowAttributes wa;
+    XClassHint ch = {"dwm-badge", "dwm-badge"};
+    XWindowChanges wc;
+    XftFont *font;
+    XftDraw *d;
+    XGlyphInfo ext;
+    char pattern[256];
+
+    if (!c->isglobal || !c->mon) {
+        if (c->badge) {
+            XDestroyWindow(dpy, c->badge);
+            c->badge = None;
+        }
+        return;
+    }
+    if (pm == None) { /* 所有徽章共用一张图: 先整张清为透明, 再按字形外框居中画图钉 */
+        snprintf(pattern, sizeof pattern, "%s:pixelsize=%d", fonts[0], drw->fonts->h * 4);
+        if (!(font = XftFontOpenName(dpy, screen, pattern)))
+            return;
+        XftTextExtentsUtf8(dpy, font, (XftChar8 *)"󰐃", strlen("󰐃"), &ext);
+        badgew = ext.width ? ext.width : 1;
+        badgeh = ext.height ? ext.height : 1;
+        pm = XCreatePixmap(dpy, root, badgew, badgeh, depth);
+        XSetForeground(dpy, drw->gc, 0);
+        XFillRectangle(dpy, pm, drw->gc, 0, 0, badgew, badgeh);
+        d = XftDrawCreate(dpy, pm, visual, cmap);
+        XftDrawStringUtf8(d, &scheme[SchemeSel][ColFg], font, ext.x, ext.y,
+                (XftChar8 *)"󰐃", strlen("󰐃"));
+        XftDrawDestroy(d);
+        XftFontClose(dpy, font);
+    }
+    if (!c->badge) {
+        wa.override_redirect = True;
+        wa.background_pixmap = pm;
+        wa.border_pixel = 0;
+        wa.colormap = cmap;
+        c->badge = XCreateWindow(dpy, root, 0, 0, badgew, badgeh, 0, depth, InputOutput, visual,
+                CWOverrideRedirect|CWBackPixmap|CWBorderPixel|CWColormap, &wa);
+        XSetClassHint(dpy, c->badge, &ch); /* picom 按 class 排除阴影和背景模糊 */
+        XShapeCombineRectangles(dpy, c->badge, ShapeInput, 0, 0, NULL, 0, ShapeSet, YXBanded);
+    }
+    if (HIDDEN(c) || c->isfullscreen || !ISVISIBLE(c)) {
+        XUnmapWindow(dpy, c->badge);
+        return;
+    }
+    wc.x = c->x + WIDTH(c) - c->bw - badgew;
+    wc.y = c->y + c->bw;
+    wc.sibling = c->win;
+    wc.stack_mode = Above;
+    XConfigureWindow(dpy, c->badge, CWX|CWY|CWSibling|CWStackMode, &wc);
+    XMapWindow(dpy, c->badge);
+}
+
+void
+updatebadges(Monitor *m)
+{
+    Client *c;
+
+    for (c = m->clients; c; c = c->next)
+        if (c->isglobal)
+            updatebadge(c);
+}

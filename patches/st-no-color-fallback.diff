+/*
+ * 彩色 (位图 emoji) 字体的字形很大, 上传给 X 时 RenderAddGlyphs 会报 BadLength,
+ * st 随即退出 (如 Claude Code 等界面输出 emoji 时终端直接关闭), 回退时一律跳过.
+ */
+static int
+fontiscolor(FcPattern *p)
+{
+	FcBool color;
+
+	return FcPatternGetBool(p, FC_COLOR, 0, &color) == FcResultMatch && color;
+}

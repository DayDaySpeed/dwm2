+void
+restart(const Arg *arg)
+{
+    restarting = 1;
+    running = 0;
+}
+
+/* 收到 SIGHUP 时原地重启 (bin/reload.sh 编译安装新版本后发送);
+ * 主循环阻塞在 XNextEvent, 需再触发任意 X 事件 (如更新 root 窗口标题) 才会退出循环 */
+void
+sighup(int unused)
+{
+    restart(NULL);
+}
+
+/* 重启前: 把每个窗口的 tag/浮动/全局/隐藏 状态记在窗口属性 _DWM_STATE 上, 当前视图记在 root 的 _DWM_VIEW 上;
+ * 隐藏的窗口先重新映射, 否则 cleanup 后它们处于 Withdrawn 且未映射, 新的 dwm scan 时会丢失 */
+void
+saveclientstates(void)
+{
+    Atom state = XInternAtom(dpy, "_DWM_STATE", False);
+    Atom viewatom = XInternAtom(dpy, "_DWM_VIEW", False);
+    Monitor *m;
+    Client *c;
+    long data[5], v = selmon->tagset[selmon->seltags], idx;
+
+    for (m = mons; m; m = m->next)
+        for (c = m->clients, idx = 0; c; c = c->next, idx++) {
+            data[0] = c->tags;
+            data[1] = c->isfloating;
+            data[2] = c->isglobal;
+            data[3] = HIDDEN(c) ? (c->hideseq ? c->hideseq : 1) : 0; /* 隐藏序号, 保留恢复顺序 */
+            data[4] = idx;
+            XChangeProperty(dpy, c->win, state, XA_CARDINAL, 32, PropModeReplace, (unsigned char *)data, 5);
+            if (data[3])
+                XMapWindow(dpy, c->win);
+        }
+    XChangeProperty(dpy, root, viewatom, XA_CARDINAL, 32, PropModeReplace, (unsigned char *)&v, 1);
+    XSync(dpy, False);
+}
+
+/* 接管窗口时: 读回并删除 _DWM_STATE, 恢复 tag/浮动/全局; 返回该窗口重启前的隐藏序号 (0 表示未隐藏) */
+unsigned long
+restoreclientstate(Client *c)
+{
+    Atom state = XInternAtom(dpy, "_DWM_STATE", False), type;
+    int format;
+    unsigned long hidden = 0;
+    unsigned long n, after;
+    unsigned char *p = NULL;
+
+    c->restoreidx = -1;
+    if (XGetWindowProperty(dpy, c->win, state, 0, 5, True, XA_CARDINAL,
+            &type, &format, &n, &after, &p) == Success && p) {
+        if (n == 5) {
+            long *d = (long *)p;
+            if (d[0] & TAGMASK)
+                c->tags = d[0] & TAGMASK;
+            c->isfloating = d[1];
+            c->isglobal = d[2];
+            hidden = d[3];
+            c->restoreidx = d[4];
+        }
+        XFree(p);
+    }
+    return hidden;
+}
+
+/* 原地重启后按 restoreidx 恢复每个显示器上窗口的先后顺序 (scan 时逐个 attach 到链表头, 顺序会颠倒) */
+void
+restoreclientorder(void)
+{
+    Monitor *m;
+    Client *c, **v;
+    int n, i, j;
+
+    for (m = mons; m; m = m->next) {
+        for (n = 0, c = m->clients; c; c = c->next, n++);
+        if (n < 2 || !(v = malloc(n * sizeof(Client *))))
+            continue;
+        for (i = 0, c = m->clients; c; c = c->next)
+            v[i++] = c;
+        for (i = 1; i < n; i++) /* 插入排序: 有记录的按原位置, 没有记录的排在后面 */
+            for (j = i; j > 0 && (v[j]->restoreidx >= 0 && (v[j-1]->restoreidx < 0 || v[j-1]->restoreidx > v[j]->restoreidx)); j--) {
+                c = v[j]; v[j] = v[j-1]; v[j-1] = c;
+            }
+        for (i = 0; i < n; i++)
+            v[i]->next = i + 1 < n ? v[i+1] : NULL;
+        m->clients = v[0];
+        free(v);
+        arrange(m);
+    }
+}
+
 Monitor *
 recttomon(int x, int y, int w, int h)
 {
@@ -3876,10 +3985,33 @@ main(int argc, char *argv[])
         die("pledge");
 #endif /* __OpenBSD__ */
     scan();
-    runAutostart();
+    signal(SIGHUP, sighup);
+    if (getenv("DWM_RESTARTED")) {
+        /* 原地重启: 不重复执行 autostart, 恢复重启前所看的 tag */
+        Atom viewatom = XInternAtom(dpy, "_DWM_VIEW", False), type;
+        int format;
+        unsigned long n, after;
+        unsigned char *p = NULL;
+        if (XGetWindowProperty(dpy, root, viewatom, 0, 1, True, XA_CARDINAL,
+                &type, &format, &n, &after, &p) == Success && p) {
+            if (n == 1 && (*(long *)p & TAGMASK))
+                view(&(Arg){ .ui = *(long *)p & TAGMASK });
+            XFree(p);
+        }
+        restoreclientorder();
+        unsetenv("DWM_RESTARTED");
+    } else
+        runAutostart();
     run();
+    if (restarting)
+        saveclientstates();
     cleanup();
     XCloseDisplay(dpy);
+    if (restarting) {
+        setenv("DWM_RESTARTED", "1", 1);
+        execvp(argv[0], argv);
+        die("dwm: restart failed:");
+    }
     return EXIT_SUCCESS;
 }
 

+static int
+fonthaschar(FcPattern *p, Rune rune)
+{
+	FcCharSet *cs;
+
+	return FcPatternGetCharSet(p, FC_CHARSET, 0, &cs) == FcResultMatch
+		&& FcCharSetHasChar(cs, rune);
+}

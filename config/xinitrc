# ~/.xinitrc -> $DWM/config/xinitrc
# 这里只放 环境变量 与 必须先于 dwm 的会话服务; 其余启动项都在 $DWM/bin/autostart.sh

# 项目根目录: 所有配置在 $DWM/config, 所有脚本在 $DWM/bin
export DWM=~/projs/dwm2

# ================================================
# UI 缩放(2560×1440 全局 1.35×;须最先设置)
# 勿设 GDK_SCALE=1,否则会与 Xft.dpi 冲突导致对话框错位/缩小
# ================================================

export XCURSOR_SIZE=32
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_SCALE_FACTOR=1.35
export QT_SCREEN_SCALE_FACTORS=1.35

# ================================================
# 输入法配置
# ================================================

export GTK_IM_MODULE=fcitx5
export QT_IM_MODULE=fcitx5
export XMODIFIERS="@im=fcitx5"
export GLFW_IM_MODULE=ibus # ← 加这行,kitty 用这个对接输入法

# ================================================
# 会话服务
# ================================================

# Xft.dpi 等;须在 GTK 程序与 portal 之前加载
xrdb -merge "$DWM/config/Xresources"

export XDG_CURRENT_DESKTOP=dwm
systemctl --user import-environment \
  DISPLAY XAUTHORITY XCURSOR_SIZE \
  QT_AUTO_SCREEN_SCALE_FACTOR QT_SCALE_FACTOR QT_SCREEN_SCALE_FACTORS \
  GTK_IM_MODULE QT_IM_MODULE XMODIFIERS
systemctl --user reset-failed xdg-desktop-portal-gtk.service 2>/dev/null
systemctl --user restart xdg-desktop-portal.service xdg-desktop-portal-gtk.service 2>/dev/null || \
  systemctl --user start xdg-desktop-portal-gtk.service

# polkit 认证代理(必须在 exec dwm 之前启动,否则特权操作每次都要重新认证)
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# ================================================
# 启动窗口管理器(必须放最后)
# ================================================

exec dwm
